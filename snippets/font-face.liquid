{% style %}
    @font-face {
    font-family: "HelveticaBold";
    src: url("{{ 'HelveticaBold.woff2' | asset_url }}") format("woff2"),
    url('{{ "HelveticaBold.woff" | asset_url }}') format("woff");
    font-display: swap;
  }

  @font-face {
    font-family: "HelveticaLight";
    src: url("{{ 'HelveticaLight.woff2' | asset_url }}") format("woff2"),
    url('{{ "HelveticaLight.woff" | asset_url }}') format("woff");
    font-display: swap;
  }
{% endstyle %}